; RB2301 CA2 - real-life maze placement + goal points, as measured in the
; Optitrack world frame.
;
; The real maze uses the SAME layout as the Gazebo sim maze (ca2_sim_map.npy)
; -- both real mazes (maze0, maze1) are that same layout too -- but built at
; HALF the scale: 0.1m cells instead of the sim's 0.2m (see irl_resolution in
; path_planning.py). Only where each maze is physically placed in the room
; (origin_x/origin_y) and which cells are used as goals (goal_list) differ
; between the two mazes.
;
; origin_x / origin_y = world coordinates of the grid's [0, 0] corner
;                        (i.e. the physical corner of the maze, not a goal).
; goal_list            = list of (x, y) world coordinates, in order, that the
;                        robot must reach. Must land inside a free cell.
;                        These are at 0.1m scale, NOT the sim's 0.2m scale.
;
; Instructor/TA: update these before each lab session to match the current
; physical placement of each maze. The values below are placeholders --
; same origin as the sim default, and goal_list picks the same relative
; cells as the sim goals but converted at the real maze's 0.1m resolution,
; so they're guaranteed to land in free cells of the shared layout -- replace
; both sections with the real measured origins, and give maze1 a different
; goal sequence, once both mazes are set up.

[maze0]
; TODO: replace with maze 0's actual measured origin + goal points
origin_x = -1.0
origin_y = -5.0
goal_list = (1.25, -4.25), (1.15, -2.35), (0.75, -4.25), (-0.65, -4.35)

[maze1]
; TODO: replace with maze 1's actual measured origin + a different goal sequence
origin_x = -1.0
origin_y = -5.0
goal_list = (1.25, -4.25), (1.15, -2.35), (0.75, -4.25), (-0.65, -4.35)
