; RB2301 Final Project - where the CA2 maze frame sits in the Optitrack frame. Already filled in: don't edit.
;
; Poses on the real robot are reported in the CA2 MAZE frame: (0, 0) is the outer corner of the CA2 maze,
; +x / +y are the maze's axes, heading is 0 along +x and +90 along +y (counter-clockwise positive, degrees).
; Rigid bodies are created in Motive with the robot facing +y of that frame.
;
;   origin_x, origin_y : the Optitrack (x, y), in metres, of the CA2 maze's (0, 0) corner
;   rotation_deg       : the angle, in degrees, of the CA2 maze's +x axis in the Optitrack frame (counter-clockwise positive)
;
; [course] is OPTIONAL: where the final project's own start point sits in the CA2 maze frame, for converting with
; self.to_course(). Defaults mean "no conversion".

[frame]
origin_x = 2.746
origin_y = -2.926
rotation_deg = 87.86
; heading_offset_deg: "auto" (default) assumes every Motive rigid body was created with the robot FACING THE MAZE'S +y DIRECTION
; ("up" the left side of the CA2 maze map). The package then reports
; maze heading = Motive heading + 90, so students never deal with it. A number (degrees, = reported heading minus the
; true maze heading) overrides it for all robots.
heading_offset_deg = auto

[heading_offsets]
; Optional per-robot override, as  <robot number> = <degrees>, for a rigid body that was NOT created facing maze +y
; Measured 2026-10-05, each verified to within 1 degree (auto would give -177.9, so these two differ by 0.2 and 2.5 degrees).
7 = -177.7
12 = -175.4

[course]
; (x, y) of the final-project start point in the CA2 maze frame, and the angle of the course's +x axis in that frame.
origin_x = 0.0
origin_y = 0.0
rotation_deg = 0.0
